APP_ENV=development
HTTP_ADDR=:8080
# Required by cmd/api: base64-encoded random key of at least 32 bytes.
JWT_SIGNING_KEY=
REDIS_URL=redis://:local-dev-redis-password@localhost:6379/0
POSTGRES_DB=spirit_embassy
POSTGRES_USER=spirit_embassy
# Local development only; replace with a random alphanumeric secret in backend/.env.
POSTGRES_PASSWORD=local-dev-postgres-password
REDIS_PASSWORD=local-dev-redis-password
POSTGRES_PORT=5432
REDIS_PORT=6379
HTTP_PORT=8080
DATABASE_URL=postgres://spirit_embassy:replace-with-local-password@localhost:5432/spirit_embassy?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:4200
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_MAX_CONNECTION_LIFETIME=1h
